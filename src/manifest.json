{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Captode",
  "version": "1.5.2",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "homepage_url": "https://github.com/nevin/Captode",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Captode",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "tabCapture",
    "offscreen",
    "storage",
    "unlimitedStorage"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "__MSG_commandAction__"
    },
    "capture-full": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "__MSG_menu_full_page__"
    },
    "capture-visible": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "__MSG_menu_visible__"
    },
    "capture-area": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "__MSG_menu_area__"
    },
    "capture-element": {
      "description": "__MSG_menu_element__"
    }
  },
  "options_page": "settings/settings.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
